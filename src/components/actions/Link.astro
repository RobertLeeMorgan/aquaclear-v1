---
import {ArrowRight} from "lucide-astro"

interface Props {
    title: string;
    href?: string;
    className?: string;
}

const { href, title, className = "" } = Astro.props;
---

{href ? (
    <a href={href} class:list={["link link-motion", className, ]}>
        {title}
        <ArrowRight class="icon-sm" aria-hidden="true" />
    </a>
    ) : (
    <span class:list={["link link-motion", className, ]}>
        {title}
        <ArrowRight class="icon-sm" aria-hidden="true" />
    </span>)
}