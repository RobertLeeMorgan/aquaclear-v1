---
import TwoColumns from "../layout/TwoColumns.astro";
import ThreeColumns from "../layout/ThreeColumns.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Link from "../actions/Link.astro";
import MediaFrame from "../media/MediaFrame.astro";

import type { RichTextSection, ResponsiveProfileEnum } from "../../lib/types";

interface Props extends RichTextSection {
  imagePosition?: "left" | "right";
  responsive?: ResponsiveProfileEnum;
  editorial?: boolean;

  wide?: boolean;

  readMore?: {
    title: string;
    href: string;
  };

  layout?: "two-column" | "three-column";

  ratio?:
    | "auto"
    | "square"
    | "portrait"
    | "landscape"
    | "video";
}

const {
  eyebrow,
  title,
  content,
  media,
  responsive,
  imagePosition,
  readMore,
  editorial,
  wide = false,
  layout = "two-column",
  ratio
} = Astro.props as Props;
---

{layout === "two-column" ? (
<TwoColumns reverse={imagePosition === "left"} wide={wide} >
  <div class="flex flex-col justify-center">
    {!editorial && title &&
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
      />
    }
    <div class="prose prose-neutral mt-xl max-w-none whitespace-pre-line">
      <Fragment set:html={content} />
    </div>

    {readMore && (
        <div class="mt-md"> 
          <Link href={readMore.href} title={readMore.title} className="text-lg" />
        </div>
    )}
  </div>

  {media && (
    <MediaFrame
      media={media}
      responsive={responsive}
      ratio={ratio}
      class="section-img"
    />
  )}
</TwoColumns> 
) : (
<ThreeColumns>
  <div>
    {eyebrow && title && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
      />
    )}
  </div>

  <div class="prose prose-neutral max-w-none whitespace-pre-line">
    <Fragment set:html={content} />

    {readMore && (
      <Link href={readMore.href} title={readMore.title} />
    )}
  </div>

  {media && (
    <MediaFrame
      media={media}
      responsive={responsive}
      class="section-img"
    />
  )}
</ThreeColumns>
)}