---
import TwoColumns from "../layout/TwoColumns.astro";
import ThreeColumns from "../layout/ThreeColumns.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Link from "../actions/Link.astro";
import MediaFrame from "../media/MediaFrame.astro";

import type { RichTextSection, ResponsiveProfileEnum } from "../../lib/types";
import Button from "../actions/Button.astro";

interface Props extends RichTextSection {
  imagePosition?: "left" | "right";
  responsive?: ResponsiveProfileEnum;
  editorial?: boolean;

  wide?: boolean;

  readMore?: {
    title: string;
    href: string;
  };

  layout?: "two-column" | "three-column";

  ratio?:
    | "auto"
    | "square"
    | "portrait"
    | "landscape"
    | "video";

  dark?: boolean
}

const {
  eyebrow,
  title,
  content,
  media,
  responsive,
  imagePosition,
  readMore,
  editorial,
  wide = false,
  layout = "two-column",
  ratio,
  dark = false,
  buttons
} = Astro.props as Props;
---

{layout === "two-column" ? (
  <TwoColumns reverse={imagePosition === "left"} wide={wide} >
    <div class="flex flex-col justify-center">
      {!editorial && title &&
        <SectionHeader
          eyebrow={eyebrow}
          title={title}
          dark={dark}
        />
      }
      <div class={`prose prose-neutral max-w-none whitespace-pre-line ${title && "mt-xl"} ${dark && "text-inverse-muted"}`}>
        <Fragment set:html={content} />
      </div>

      

      {(buttons || readMore) && (
            <div class="mt-8">
              {buttons?.map((button: any, index: number) => (
                <Button
                  {...button}
                  variant={index === 1 ? "dark" : "primary"}
                />
              ))}

              {readMore && (
                <Link
                  href={readMore.href}
                  title={readMore.title}
                />
              )}
            </div>
          )}
    </div>

    {media && (
      <MediaFrame
        media={media}
        responsive={responsive}
        ratio={ratio}
        class="section-img"
      />
    )}
  </TwoColumns> 
  ) : (
  <ThreeColumns>
    {eyebrow && title && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
      />
    )}

    <div class="prose prose-neutral max-w-none whitespace-pre-line">
      <Fragment set:html={content} />

      {readMore && (
        <Link href={readMore.href} title={readMore.title} />
      )}
    </div>

    {media && (
      <MediaFrame
        media={media}
        responsive={responsive}
        class="section-img"
      />
    )}
  </ThreeColumns>
)}