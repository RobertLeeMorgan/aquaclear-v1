---
import * as Lucide from "lucide-astro";
import { featureIconMap } from "../../utils/featureIcon";

const { items, className = "", listStyle } = Astro.props;
---

<ul
  class:list={[
    "grid grid-cols-1 gap-x-lg gap-y-md sm:grid-cols-2 items-stretch",
    listStyle !== "client" ? "mt-xl" : "mt-2xl",
    className,
  ]}
>
  {items.map((item: any) => {
    const Icon = featureIconMap[item.icon] ?? Lucide.Check;

    return (
      <li class="grid grid-cols-[auto_1fr] items-center gap-sm">
        <Icon
          class="icon-md shrink-0 text-primary"
          aria-hidden="true"
        />

        <span class="body">
          {item.title}
        </span>
      </li>
    );
  })}
</ul>