---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  className?: string;
  as?: "h1" | "h2" | "h3";
  align?: "start" | "center" | "end";
  dark?: boolean
}

const {
  eyebrow,
  title,
  description,
  className = "",
  as = "h2",
  align = "start",
  dark = false
} = Astro.props as Props;

const Heading = as;

const alignment = {
  start: {
    container: "",
    description: "",
  },

  center: {
    container: "text-center",
    description: "mx-auto",
  },

  end: {
    container: "text-right",
    description: "ml-auto",
  },
}[align];
---

<div
  class:list={[
    alignment.container,
    className
  ]}
>
  {eyebrow && (
    <p class="eyebrow">
      {eyebrow}
    </p>
  )}

  <Heading class:list={[dark ? "mt-xs text-inverse" : "mt-xs", as === "h1" ? "display-lg" : "display"]}>
    {title}
  </Heading>

  {description && (
    <p
      class:list={[
        "body reading mt-lg whitespace-pre-line",
        dark && "text-inverse-muted",
        alignment.description,
      ]}
    >
      {description}
    </p>
  )}
</div>