---
import type { TestimonialType } from '../../../lib/types';
import AppImage from '../../media/AppImage.astro';
import { Quote } from "lucide-astro";

interface Props extends TestimonialType{}

const {
  quote,
  author,
  role,
  company,
  avatar,
  rating,
} = Astro.props as Props;
---

<div class="card card-motion h-full bg-surface-dark/5">
  <div class="card-padding flex h-full flex-col">

    <div class="relative flex-1">
      <span class="absolute -left-3 font-serif text-7xl leading-none text-accent">
        “
      </span>

      <blockquote class="body pl-6 text-inverse">
        {quote}
      </blockquote>
    </div>

    <footer class="mt-xl flex items-center gap-md">

      {avatar && (
        <AppImage
          src={avatar}
          alt={author}
          responsive="thumbnail"
          class="size-12 rounded-full"
        />
      )}

      <div class="stack-xs">
        <p class="subheading text-inverse">
          {author}
        </p>

        {(role || company) && (
          <p class="caption text-inverse-muted">
            {[role, company].filter(Boolean).join(", ")}
          </p>
        )}
      </div>

    </footer>

  </div>
</div>