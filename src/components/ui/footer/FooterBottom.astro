---
import { site } from "../../../config/site";
---

<div class="border-t border-white/10">
    <div class="container flex flex-col gap-sm py-lg px-sm md:flex-row md:justify-between">
      <p class="caption text-inverse-muted">
        © 2026 {site.name} Ltd. All rights reserved.
      </p>

      <div class="cluster-sm">

        <a
          href="/terms"
          class="link link-inverse link-motion"
        >
          Terms of Use
        </a>

        <a
          href="/privacy"
          class="link link-inverse link-motion"
        >
          Privacy Policy
        </a>

      </div>

      <p class="caption text-inverse-muted">
        Website by{" "}
        <a
          href="https://robertmorgan.dev"
          target="_blank"
          class="link link-inverse link-motion"
        >
          Rob Morgan
        </a>
      </p>
    </div>
  </div>