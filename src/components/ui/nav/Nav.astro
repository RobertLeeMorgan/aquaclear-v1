---
import { getNavItems } from "../../../lib/navigation";
import Button from "../../actions/Button.astro";

import NavBrand from "./NavBrand.astro";
import NavDesktop from "./NavDesktop.astro";
import NavMobile from "./NavMobile.astro";

const navItems = await getNavItems();
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 z-nav w-full nav">
  <div class="flex items-center px-md sm:px-lg lg:px-2xl py-xs">

    <div class="flex-1">
      <NavBrand />
    </div>

    <NavDesktop
      navItems={navItems}
      currentPath={currentPath}
    />

    <div class="flex-1 hidden lg:flex justify-end">
      <Button href="/contact" variant="outline" size="sm" title="Free Quote"/>
    </div>

    <NavMobile
      navItems={navItems}
      currentPath={currentPath}
    />

  </div>
</header>

<script>
  import "../../../scripts/nav";
</script>