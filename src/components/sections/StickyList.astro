---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Button from "../actions/Button.astro";
import type { StickyListSection } from "../../lib/types";

interface Props extends StickyListSection {}

const {
  eyebrow,
  title,
  description,
  groups,
  buttons,
} = Astro.props as Props;
---

<Section id={title}>
  <Container>
    <div class="grid grid-cols-1 gap-3xl lg:grid-cols-3">

      <div class="h-fit lg:sticky lg:top-3xl">
        <SectionHeader
          eyebrow={eyebrow}
          title={title}
          description={description}
        />

        {buttons && (
          <div class="cluster-md mt-xl">
            {buttons.map((button, index) => (
              <Button
                {...button}
                variant={index === 1 ? "dark" : "primary"}
              />
            ))}
          </div>
        )}
      </div>

      <div class="stack-2xl lg:col-span-2">
        {groups.map((group) => (
          <div>
            <p class="eyebrow mb-md">
              {group.title}
            </p>

            <div class="stack-md">
              {group.items.map((item) => (
                <div class="card p-sm">
                  <h3 class="subheading">
                    {item.title}
                  </h3>

                  {item.description && (
                    <p class="body text-muted mt-xs reading">
                      {item.description}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>