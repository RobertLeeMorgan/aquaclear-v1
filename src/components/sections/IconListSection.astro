---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import SectionHeader from "../content/SectionHeader.astro";
import MediaFrame from "../media/MediaFrame.astro";
import TwoColumns from "../layout/TwoColumns.astro";
import IconList from "../content/IconList.astro";
import Button from "../actions/Button.astro";
import Link from "../actions/Link.astro";

import type { IconListSection } from "../../lib/types";

interface Props extends IconListSection {
  imagePosition?: "left" | "right";

  readMore?: {
    href: string;
    title: string;
  };

  dark?: boolean;
  secondary?: boolean
  listStyle?: "default" | "client";
}

const {
  eyebrow,
  title,
  description,
  items,
  buttons,
  media,
  imagePosition = "right",
  readMore,
  dark,
  secondary,
  listStyle = "default"
} = Astro.props as Props;
---

<Section id={title} dark={dark} secondary={secondary}>
  <Container>
    {listStyle === "client" ? (
      <TwoColumns reverse={imagePosition === "left"}>
          <SectionHeader
            eyebrow={eyebrow}
            title={title}
            description={description}
          />

          <IconList items={items} />
      </TwoColumns>
    ) : (
      <TwoColumns reverse={imagePosition === "left"}>
        <MediaFrame
          media={media}
          responsive="large"
          class="section-img"
        />

        <div class="flex flex-col justify-center">
          <SectionHeader
            eyebrow={eyebrow}
            title={title}
            description={description}
          />

          <IconList items={items} listStyle={listStyle}/>

          {(buttons || readMore) && (
            <div class="mt-8">
              {buttons?.map((button: any, index: number) => (
                <Button
                  {...button}
                  variant={index === 1 ? "dark" : "primary"}
                />
              ))}

              {readMore && (
                <Link
                  href={readMore.href}
                  title={readMore.title}
                />
              )}
            </div>
          )}
        </div>
      </TwoColumns>
    )}
  </Container>
</Section>