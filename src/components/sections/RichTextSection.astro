---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import RichText from "../content/RichText.astro";
import SectionHeader from "../content/SectionHeader.astro";
import type { RichTextSection, ResponsiveProfileEnum } from "../../lib/types";
import PlantGroup from "../../assets/images/svg/plantGroup.svg"

interface Props extends RichTextSection {
  imagePosition?: "left" | "right";
  responsive?: ResponsiveProfileEnum;

  editorial?: boolean;

  wide?: boolean;

  readMore?: {
    title: string;
    href: string;
  };

  layout?: "two-column" | "three-column";

  dark?: boolean;
  secondary?: boolean;
  decoration?: boolean
}

const props = Astro.props as Props;

---

<Section id={props.title} dark={props.dark} secondary={props.secondary}>
  
  <Container>
    {props.editorial &&
      <SectionHeader
        eyebrow={props.eyebrow}
        title={props.title}
      />
    }
    <RichText {...props}/>
    {props.decoration && 
    <PlantGroup
      class:list={[
        "decorative -bottom-2 left-[4%] w-68",
        props.dark
          ? "text-surface/10"
          : props.secondary
            ? "text-dark/10"
            : "text-surface-alt",
      ]}
    />
  }
  </Container>
</Section>