---
import AppImage from "../media/AppImage.astro";
import Button from "../actions/Button.astro";
import type { HeroSection } from "../../lib/types";

interface Props extends HeroSection {
  height?: "sm" | "md" | "lg";

  align?: "left" | "right";
  vertical?: "center" | "bottom";

  overlay?: "none" | "light" | "dark";

  class?: string
}

const {
  title,
  description,

  image,
  alt = "",

  buttons,

  height = "md",

  align = "left",
  vertical = "center",

  class: className,

  overlay = "light",
} = Astro.props as Props;

const heightClass = {
  sm: "h-[80vh]",
  md: "h-[85vh]",
  lg: "h-[100vh]",
}[height];

const alignmentClass = {
  left: "justify-start text-start",
  right: "justify-end text-end",
}[align];

const verticalClass = {
  center: "items-center",
  bottom: "items-end pb-xl lg:pb-0",
}[vertical];

const overlayClass = {
  none: "",
  light: `absolute inset-0 ${align === "right" ? "bg-gradient-to-tl" : "bg-gradient-to-tr"} from-black/40 to-dark/20`,
  dark: "absolute inset-0 bg-gradient-to-tr from-black/60 to-black/20",
}[overlay];
---

<section class:list={["relative overflow-hidden bg-dark", heightClass]}>

  <AppImage
    src={image}
    alt={alt}
    responsive="large"
    class:list={["hero-img", className]}
    priority
  />

  {overlay !== "none" && (
    <div class={overlayClass} />
  )}

  <div
    class:list={[
      "relative z-10 container flex h-full hero",
      alignmentClass,
      verticalClass,
    ]}
  >
    <div class="container-lg">
      <h1 class="display-lg text-inverse">
        {title}<span class="text-accent">.</span>
      </h1>

      {description && (
        <p class="text-xl mt-lg text-inverse-muted">
          {description}
        </p>
      )}

      {buttons && (
        <div
          class:list={[
            "cluster-md mt-2xl",
            align === "right"
              ? "justify-end"
              : "justify-start",
          ]}
        >
          {buttons.map((button: any, index: number) => (
            <Button
              {...button}
              variant={index === 1 ? "dark" : "primary"}
            />
          ))}
        </div>
      )}
    </div>
  </div>

<svg
  class:list={[
    "absolute bottom-0 left-0 z-20 w-full h-16 md:h-24 pointer-events-none",
    { "scale-x-[-1]": align === "right" }
  ]}
  viewBox="0 0 1440 120"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path
    fill="var(--color-surface)"
    d="M0 50
       C180 72 360 92 540 92
       C720 92 900 58 1120 50
       C1230 50 1340 50 1440 50
       L1440 121
       L0 121
       Z"
  />
</svg>

</section>