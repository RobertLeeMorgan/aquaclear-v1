---
import Section from "../layout/Section.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Container from "../layout/Container.astro";
import Link from "../actions/Link.astro";
import Button from "../actions/Button.astro";
import type { CtaSection } from "../../lib/types";

interface Props extends CtaSection {
  readMore?: {
    href: string;
    title: string;
  };
}

const {
  eyebrow,
  title,
  description,
  readMore,
  buttons
} = Astro.props as Props;
---

<Section id={title}>
  <Container class="text-center">

    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      align="center"
    />

    {buttons && (
      <div class="cluster-md justify-center mt-2xl">
        {buttons.map((button: any, index: number) => (
          <Button
            {...button}
            variant={index === 1 ? "dark" : "primary"}
          />
        ))}
      </div>
    )}

    {readMore && (
      <Link
        href={readMore.href}
        title={readMore.title}
      />
    )}

  </Container>
</Section>