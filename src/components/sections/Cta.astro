---
import Section from "../layout/Section.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Container from "../layout/Container.astro";
import Link from "../actions/Link.astro";
import Button from "../actions/Button.astro";
import type { CtaSection } from "../../lib/types";
import Heron1 from "../../assets/images/svg/heron1.svg"
import ReedSmallGroup from "../../assets/images/svg/reedSmallGroup.svg"

interface Props extends CtaSection {
  readMore?: {
    href: string;
    title: string;
  };

  dark?: boolean;
  secondary?: boolean
}

const {
  eyebrow,
  title,
  description,
  readMore,
  buttons,
  dark,
  secondary
} = Astro.props as Props;
---

<Section id={title} class="relative overflow-hidden" dark={dark} secondary={secondary}>
  <Heron1 class="decorative -bottom-2 right-[3%] w-28 text-dark/15" />
  <ReedSmallGroup class="decorative -bottom-2 left-[3%] w-44 text-dark/15" />
  <Container class="relative z-10 text-center">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      align="center"
    />

    {buttons && (
      <div class="cluster-md justify-center mt-2xl">
        {buttons.map((button: any, index: number) => (
          <Button
            {...button}
            variant={index === 1 ? "dark" : "primary"}
          />
        ))}
      </div>
    )}

    {readMore && (
      <Link
        href={readMore.href}
        title={readMore.title}
      />
    )}

  </Container>
</Section>