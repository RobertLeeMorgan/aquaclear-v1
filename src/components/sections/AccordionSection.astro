---
import Section from "../layout/Section.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Container from "../layout/Container.astro";
import Accordion from "../content/accordion/Accordion.astro";
import type { AccordionSection } from "../../lib/types";

interface Props extends AccordionSection{
  dark?: boolean;
  secondary?: boolean
}

const {
  title,
  description,
  eyebrow,
  groups,
  dark,
  secondary
} = Astro.props as Props;
---

<Section id={title} dark={dark} secondary={secondary}>
  <Container>
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
    />
    <div class="stack-3xl">
      {groups.map((group) => (
        <section>
          <div class="mt-2xl">
            <Accordion items={group.items} grouped={false} />
          </div>
        </section>
      ))}
    </div>
  </Container>
</Section>