---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import SectionHeader from "../content/SectionHeader.astro";
import MediaGrid from "../media/MediaGrid.astro";
import Link from "../actions/Link.astro";

import type { GallerySection, ResponsiveProfileEnum } from "../../lib/types";

interface Props extends GallerySection {
  readMore?: {
    href: string;
    title: string;
  };
  responsive?: ResponsiveProfileEnum
}

const {
  eyebrow,
  title,
  description,
  items,
  readMore,
  responsive
} = Astro.props as Props;
---

<Section id={title}>
  <Container>
    {title && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
    )}

    <MediaGrid media={items} responsive={responsive}/>

    {readMore && (
      <Link
        href={readMore.href}
        title={readMore.title}
      />
    )}
  </Container>
</Section>