---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Card from "../content/cards/Card.astro";
import Link from "../actions/Link.astro";

import type { CardsSection } from "../../lib/types";

interface Props extends CardsSection {
  layout?: "grid" | "stack";

  cardLayout?: "vertical" | "horizontal" | "compact";

  columns?: 1 | 2 | 3 | 4;

  ellipsis?: 2 | 3 | 4;

  readMore?: {
    href: string;
    title: string;
  };
}

const {
  eyebrow,
  title,
  description,
  items,

  layout = "grid",
  cardLayout = "vertical",

  columns = 3,
  ellipsis,

  readMore,
} = Astro.props as Props;

const gridClass = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 xl:grid-cols-4",
}[columns];
---

<Section id={title}>
  <Container>

    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
    />

    <div
      class:list={[
        layout === "grid"
          ? ["mt-3xl", "grid", "gap-xl", gridClass]
          : ["mt-xl", "stack-lg"],
      ]}
    >
      {items.map((item) => (
        <Card
          href={item.href}
          image={item.image}
          eyebrow={item.eyebrow}
          title={item.title}
          description={item.description}
          layout={cardLayout}
          ellipsis={ellipsis}
        />
      ))}
    </div>

    {readMore && (
      <Link
        href={readMore.href}
        title={readMore.title}
      />
    )}

  </Container>
</Section>