---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import SectionHeader from "../content/SectionHeader.astro";
import Carousel from "../content/carousel/Carousel.astro";
import Link from "../actions/Link.astro";
import type { CarouselSection } from "../../lib/types";
import WaterPlant from "../../assets/images/svg/WaterPlant.svg"

interface Props extends CarouselSection {
  readMore?: {
    href: string;
    title: string;
  };

  dark?: boolean;
  secondary?: boolean
}

const {
  eyebrow,
  title,
  description,
  items,
  readMore, 
  dark, 
  secondary
} = Astro.props as Props;
---

<Section id={title} dark={dark} secondary={secondary}>
  <WaterPlant class={`decorative top-12 right-[2%] w-35 sm:w-50 ${dark ? "text-surface/10" : "text-dark/10"}`} />
    <Container>
        <SectionHeader
            eyebrow={eyebrow}
            title={title}
            description={description}
            dark={dark}
        />

        <Carousel carousel={items} dark={dark}/>
        {readMore && (
          <div class="mt-4">
            <Link href={readMore.href} title={readMore.title}  />
          </div>
        )}
    </Container>
</Section>