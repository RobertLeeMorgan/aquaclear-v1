---
import Layout from "../layouts/Layout.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import { getEntry, getCollection } from "astro:content";
import { homeSchema } from "../lib/schema";
import { sortServices } from "../lib/services";

const entry = await getEntry("home", "index");

if (!entry) {
  throw new Error("Home content not found.");
}

const services = sortServices(await getCollection("services"));

const servicesItems = services
  .filter(({ id }) => ![
    "blanket-weed-removal",
    "invasive-species-removal",
    "bulrush-removal",
    "water-lily-management",
  ].includes(id))
  .map((entry) => ({
    ...entry.data.seo,
    href: `/services/${entry.id}`,
  }))
  .map((item) => ({
    title: item.title,
    description: item.description,
    image: item.image,
    href: item.href,
  }));

const schema = [
  homeSchema({
        name: entry.data.seo.title,
        description: entry.data.seo.description,
        image: entry.data.seo.image?.src,
        url: Astro.url.pathname,
      }),
];
---

<Layout title={entry.data.seo.title} description={entry.data.seo.description} image={entry.data.seo.image} schema={schema} >
  <HomeLayout
    data={entry.data}
    servicesItems={servicesItems}
  />
</Layout>
