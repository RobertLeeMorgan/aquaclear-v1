---
import Layout from "../../layouts/Layout.astro";
import CSIndexLayout from "../../layouts/CSIndexLayout.astro";
import { getEntry, getCollection } from "astro:content";
import { collectionSchema } from "../../lib/schema";

const entry = await getEntry("caseStudiesIndex", "casestudiesindex");

if (!entry) {
  throw new Error("Case Studies Index content not found.");
}

const caseStudies = await getCollection("caseStudies");

const parseDate = (date: string) =>
  new Date(
    date.replace(/(\d+)(st|nd|rd|th)/, "$1")
  ).getTime();


const sortedCaseStudies = [...caseStudies].sort(
  (a, b) =>
    parseDate(b.data.metadata.date) -
    parseDate(a.data.metadata.date)
);


const caseStudiesItems = sortedCaseStudies.map((entry) => ({
  ...entry.data.seo,
  href: `/case-studies/${entry.id}`,
  services: entry.data.metadata.services,
  sites: entry.data.metadata.sites,
  featured: entry.data.metadata.featured,
}));

const schema = [
  collectionSchema({
    name: entry.data.seo.title,
    description: entry.data.seo.description,
    image: entry.data.seo.image?.src,
    url: Astro.url.pathname,
  }),
];
---

<Layout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  image={entry.data.seo.image}
  schema={schema}
>
  <CSIndexLayout
    data={entry.data}
    caseStudiesItems={caseStudiesItems}
  />
</Layout>