---
import Layout from "../../layouts/Layout.astro";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import { getCollection } from "astro:content";
import { articleSchema } from "../../lib/schema";
import { breadcrumbSchema } from "../../lib/breadcrumbs";

export async function getStaticPaths() {
  const entries = await getCollection("caseStudies");

  return entries.map((entry) => {
    const services = entry.data.metadata.services;

    const relatedCaseStudiesItems = {
      type: "card" as const,
      card: entries
        .filter((caseStudy) => caseStudy.id !== entry.id)
        .filter((caseStudy) =>
          caseStudy.data.metadata.services.some((service) =>
            services.includes(service),
          ),
        )
        .map((caseStudy) => ({
          eyebrow: caseStudy.data.metadata.client,
          title: caseStudy.data.metadata.title,
          description: caseStudy.data.metadata.summary,
          image: caseStudy.data.seo.image,
          href: `/case-studies/${caseStudy.id}`,
        })),
    };

    return {
      params: { slug: entry.id },
      props: {
        entry,
        relatedCaseStudiesItems,
      },
    };

  });
}

const { entry, relatedCaseStudiesItems } = Astro.props;

const schema = [
  articleSchema({
    name: entry.data.seo.title,
    description: entry.data.seo.description,
    image: entry.data.seo.image?.src,
    url: Astro.url.pathname,
  }),
  await breadcrumbSchema(Astro.url.pathname, entry.data.seo.title),
];
---

<Layout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  image={entry.data.seo.image}
  schema={schema}
  ogType="article"
>
  <CaseStudyLayout
    data={entry.data}
    relatedCaseStudies={relatedCaseStudiesItems}
  />
</Layout>