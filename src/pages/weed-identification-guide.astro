---
import Layout from "../layouts/Layout.astro";
import WeedIdentificationLayout from "../layouts/WeedIdentificationLayout.astro";
import { getEntry } from "astro:content";
import { webPageSchema } from "../lib/schema";

const entry = await getEntry("weedIdentificationGuide", "weed-identification-guide");

if (!entry) {
  throw new Error("Weed Identification Guide content not found.");
}





const schema = [
  webPageSchema({
        name: entry.data.seo.title,
        description: entry.data.seo.description,
        image: entry.data.seo.image?.src,
        url: Astro.url.pathname,
      }),
];
---

<Layout title={entry.data.seo.title} description={entry.data.seo.description} image={entry.data.seo.image} schema={schema} >
  <WeedIdentificationLayout
    data={entry.data}
    
  />
</Layout>
