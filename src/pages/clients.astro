---
import Layout from "../layouts/Layout.astro";
import ClientsLayout from "../layouts/ClientsLayout.astro";
import { getEntry } from "astro:content";
import { webPageSchema } from "../lib/schema";

const entry = await getEntry("clients", "clients");

if (!entry) {
  throw new Error("Clients content not found.");
}

const schema = [
  webPageSchema({
        name: entry.data.seo.title,
        description: entry.data.seo.description,
        image: entry.data.seo.image?.src,
        url: Astro.url.pathname,
      }),
];
---

<Layout title={entry.data.seo.title} description={entry.data.seo.description} image={entry.data.seo.image} schema={schema} >
  <ClientsLayout
    data={entry.data}
  />
</Layout>
