---
import ContactForm from "../components/sections/ContactForm.astro";
import Cta from "../components/sections/Cta.astro";
import PageHeader from "../components/sections/PageHeader.astro";

const { data } = Astro.props;

---

<PageHeader title={data.getInTouch.title} eyebrow={data.getInTouch.eyebrow} description={data.getInTouch.description}/>

<ContactForm  eyebrow={data.getInTouch.eyebrow}
  title={data.getInTouch.title}
  description={data.getInTouch.description}
/>

<Cta
  eyebrow={data.callToAction.eyebrow}
  title={data.callToAction.title}
  description={data.callToAction.description}
  buttons={data.callToAction.buttons}
/>
