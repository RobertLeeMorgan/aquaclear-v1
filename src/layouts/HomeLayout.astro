---
import Banner from "../components/sections/Banner.astro";
import Cards from "../components/sections/Cards.astro";
import CarouselSection from "../components/sections/CarouselSection.astro";
import Cta from "../components/sections/Cta.astro";
import Hero from "../components/sections/Hero.astro";
import IconListSection from "../components/sections/IconListSection.astro";
import RichTextSection from "../components/sections/RichTextSection.astro";

const { data, servicesItems, servicesIndexData, featuredProjects } = Astro.props;

---
<Hero
  title={data.hero.title}
  description={data.hero.description}
  image={data.hero.image}
  alt={data.hero.alt}
  buttons={data.hero.buttons}
  overlay="light"
  class=""
/>

<RichTextSection
  eyebrow={data.introduction.eyebrow}
  title={data.introduction.title}
  content={data.introduction.content}
  media={data.introduction.media}
  wide
  buttons={data.introduction.buttons}
  readMore={data.introduction.readMore}
/>

<Banner/>

<Cards
  eyebrow="What We Do"
  title="Services"
  description="From aquatic weed cutting and reed management to silt removal and difficult on-water works, we provide practical solutions for managing and maintaining waterways across the UK."
  items={servicesItems}
  readMore={{ title: "Explore All Services", href: "/services" }}
/>

<CarouselSection
  eyebrow={servicesIndexData.siteSpecific.eyebrow}
  title={servicesIndexData.siteSpecific.title}
  description={servicesIndexData.siteSpecific.description}
  items={servicesIndexData.siteSpecific.items}
  secondary
  readMore={servicesIndexData.siteSpecific.readMore}
/>

<IconListSection
  eyebrow={data.whyChooseUs.eyebrow}
  title={data.whyChooseUs.title}
  description={data.whyChooseUs.description}
  media={data.whyChooseUs.media}
  alt={data.whyChooseUs.alt}
  items={data.whyChooseUs.items}
  buttons={data.whyChooseUs.buttons}
  readMore={data.whyChooseUs.readMore}
/>

{featuredProjects.map((project: any, index: number) => (
  <div
    data-featured-project
    data-featured-project-index={index}
    class="hidden"
  >
    <RichTextSection
      eyebrow={project.eyebrow}
      title={project.title}
      content={project.content}
      media={project.media}
      buttons={project.buttons}
      dark
      decoration
    />
  </div>
))}

<Cta
  eyebrow={data.callToAction.eyebrow}
  title={data.callToAction.title}
  description={data.callToAction.description}
  buttons={data.callToAction.buttons}
/>

<script>
  const initFeaturedProject = () => {
  const projects = Array.from(
    document.querySelectorAll("[data-featured-project]"),
  ) as HTMLElement[];

  if (projects.length <= 1) {
    return;
  }

  const selectedIndex = Math.floor(Math.random() * projects.length);

  projects.forEach((project, index) => {
    project.classList.toggle("hidden", index !== selectedIndex);
  });
};

document.addEventListener("astro:page-load", initFeaturedProject);
</script>