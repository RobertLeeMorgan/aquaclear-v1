---
import Cta from "../components/sections/Cta.astro";
import Hero from "../components/sections/Hero.astro";
import IconListSection from "../components/sections/IconListSection.astro";
import RichTextSection from "../components/sections/RichTextSection.astro";

const { data } = Astro.props;

---
<Hero
  title={data.hero.title}
  description={data.hero.description}
  image={data.hero.image}
  alt={data.hero.alt}
  buttons={data.hero.buttons}
  align="right"
  overlay="light"
/>

<RichTextSection
  eyebrow={data.truxorExpertise.eyebrow}
  title={data.truxorExpertise.title}
  content={data.truxorExpertise.content}
  media={data.truxorExpertise.media}
  buttons={data.truxorExpertise.buttons}
  readMore={data.truxorExpertise.readMore}
/>

<IconListSection
  eyebrow={data.capabilities.eyebrow}
  title={data.capabilities.title}
  description={data.capabilities.description}
  media={data.capabilities.media}
  alt={data.capabilities.alt}
  items={data.capabilities.items}
  buttons={data.capabilities.buttons}
  secondary
  readMore={data.capabilities.readMore}
/>

<RichTextSection
  eyebrow={data.aquaclearAndTruxor.eyebrow}
  title={data.aquaclearAndTruxor.title}
  content={data.aquaclearAndTruxor.content}
  media={data.aquaclearAndTruxor.media}
  readMore={data.aquaclearAndTruxor.readMore}
  dark
  decoration
/>

<Cta
  eyebrow={data.callToAction.eyebrow}
  title={data.callToAction.title}
  description={data.callToAction.description}
  buttons={data.callToAction.buttons}
/>
